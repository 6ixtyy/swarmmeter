NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Root owner account for the demo swarm (created by scripts/create-owner.ts)
OWNER_ACCOUNT=
# Free calls per owner per rolling window
FREE_CALLS_PER_WINDOW=10
WINDOW_SECONDS=3600
# Price of one top-up, and how many calls it buys
PRICE_NEAR=0.1
CALLS_PER_PAYMENT=50
# Account that receives payments
PAY_TO_ACCOUNT=
# Recipient string agents must sign for (NEP-413 recipient)
GATE_RECIPIENT=swarmmeter
PORT=8787
